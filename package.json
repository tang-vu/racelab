{
  "name": "racelab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Reproduce asynchronous failures and independently check Muse Spark code repairs.",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:judge": "node scripts/serve-judge.mjs",
    "prepare:judge": "node scripts/prepare-judge.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:config": "node scripts/check-meta-config.mjs",
    "evaluate": "node scripts/record-racelab.mjs",
    "check:local": "node scripts/check-racelab.mjs",
    "check:film": "node scripts/check-racelab-film.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "prepare:tend": "node scripts/prepare-tend.mjs",
    "evaluate:tend": "node scripts/record-tend.mjs",
    "prepare:repositories": "node scripts/prepare-repositories.mjs",
    "evaluate:repositories": "node scripts/validate-repositories.mjs",
    "evaluate:comparison": "node scripts/run-comparison.mjs",
    "evaluate:comparison:v2": "node scripts/run-comparison-v2.mjs",
    "evaluate:comparison:continuation": "node scripts/run-comparison-continuation.mjs",
    "evaluate:lifecycle": "node scripts/record-lifecycle.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10"
  }
}
