# Keep actual credentials in ignored .env.local.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=muse-spark-1.3
RACELAB_TOTAL_BUDGET_USD=150
RACELAB_PHASE_BUDGET_USD=10
RACELAB_RESERVE_USD=50
HOST=127.0.0.1
PORT=4174
# Runtime records default to .racelab/.
# RACELAB_DATA_DIR=/absolute/private/runtime-directory
# Share an existing ledger when reusing an existing funded API configuration.
# A configured external ledger must exist; it is never silently reset.
# RACELAB_LEDGER_DIR=/absolute/private/existing-ledger-directory
# RACELAB_PUBLIC_ORIGIN=https://racelab.example.com
# RACELAB_DEMO_ACCESS_CODE=
